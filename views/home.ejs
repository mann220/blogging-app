<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title>HomePage</title>
</head>
<body>
    <%- include("./partials/nav") %>
    <div class="container mt-5">
        <h2 class="mb-4">Recent Blogs</h2>
        
        <!-- This creates a grid: 1 column on mobile, 3 columns on desktop -->
        <div class="row row-cols-1 row-cols-md-3 g-4">
            
            <!-- Safely check if we passed an array of blogs from the backend -->
            <% if (locals.blogs && blogs.length > 0) { %>
                <% blogs.forEach(blog => { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <!-- Cover Image -->
                            <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="Blog Cover image" style="height: 200px; object-fit: cover;">
                            
                            <div class="card-body d-flex flex-column">
                                <!-- Title -->
                                <h5 class="card-title"><%= blog.title %></h5>
                                
                                <!-- Excerpt: We use substring to show only the first 100 characters so the cards stay neat -->
                                <p class="card-text text-muted">
                                    <%= blog.body.substring(0, 100) %>...
                                </p>
                                
                                <!-- Read More Button (pushes to the bottom of the card) -->
                                <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary mt-auto">Read More</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
                <% } else { %>
                    <!-- 🎨 Beautiful Empty State UI -->
                    <div class="col-12 mt-5">
                        <div class="text-center p-5 bg-light border rounded-3 shadow-sm mx-auto" style="max-width: 600px;">
                            <!-- An emoji or SVG icon as a visual anchor -->
                            <div class="display-1 text-muted mb-3">📝</div>
                            
                            <h3 class="fw-bold text-dark">No Blogs Published Yet</h3>
                            <p class="text-muted mb-4 lead">
                                The canvas is completely blank! Be the first one to share your ideas, stories, and thoughts with the world.
                            </p>
                            
                            <!-- Smart Button: Checks if they are logged in -->
                            <% if (locals.user) { %>
                                <a href="/blog/add-new" class="btn btn-primary btn-lg px-4 shadow-sm">
                                    Write Your First Blog
                                </a>
                            <% } else { %>
                                <a href="/user/signin" class="btn btn-primary btn-lg px-4 shadow-sm">
                                    Log In to Start Writing
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% } %>
        </div>
    </div>
    <%- include("./partials/script") %>
</body>
</html>